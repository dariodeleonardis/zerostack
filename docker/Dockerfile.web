# Multi-stage production build for ZeroStack Web
FROM node:20-alpine AS base
# Prisma su Alpine carica il motore solo se c'è OpenSSL (senza, ogni query fallisce)
RUN apk add --no-cache openssl

# Stage 1: Dependencies
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY packages/database/package*.json ./packages/database/
COPY packages/email/package*.json ./packages/email/
COPY apps/web/package*.json ./apps/web/

RUN npm install

# Stage 2: Builder
FROM base AS builder
WORKDIR /app
# Tutta /app e non solo node_modules: npm mette alcune librerie nelle cartelle dei singoli
# workspace (apps/web/node_modules/@tiptap/react, packages/email/node_modules/@react-email/render).
# Copiando solo la cartella principale la build falliva con "Module not found" (deploy del 1/10).
COPY --from=deps /app ./
COPY . .

# Generate Prisma client
WORKDIR /app/packages/database
RUN npx prisma generate

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build --workspace=@zerostack/web

# Stage 3: Runner
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs
# File caricati (STORAGE_DRIVER=local): cartella del volume, scrivibile dall'utente del server.
RUN mkdir -p /data/uploads && chown nextjs:nodejs /data/uploads

COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/web/server.js"]
