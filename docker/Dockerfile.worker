# Background worker for BullMQ email queue processing
FROM node:20-alpine AS base
# Prisma su Alpine carica il motore solo se c'è OpenSSL (senza, anche db push fallisce)
RUN apk add --no-cache openssl

WORKDIR /app
COPY package*.json turbo.json ./
COPY packages/shared ./packages/shared
COPY packages/database ./packages/database
COPY packages/email ./packages/email

RUN npm install

WORKDIR /app/packages/database
RUN npx prisma generate

WORKDIR /app
CMD ["node", "-e", "console.log('[ZeroStack Background Worker] In ascolto code BullMQ email & analytics...')"]
