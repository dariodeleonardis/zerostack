# Worker: newsletter e post programmati (coda nel database). Serve anche per le migrazioni del database.
FROM node:20-alpine AS base
# Prisma su Alpine carica il motore solo se c'è OpenSSL (senza, anche le migrazioni falliscono)
# postgresql16-client: pg_dump per i backup (stessa versione del server, altrimenti si rifiuta)
RUN apk add --no-cache openssl postgresql16-client tar

WORKDIR /app
COPY package*.json ./
COPY packages/shared ./packages/shared
COPY packages/database ./packages/database
COPY packages/email ./packages/email
COPY apps/worker ./apps/worker

RUN npm install

WORKDIR /app/packages/database
RUN npx prisma generate

WORKDIR /app
CMD ["npm", "run", "start", "--workspace=@zerostack/worker"]
