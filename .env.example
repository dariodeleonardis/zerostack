# ==============================================================================
# ZeroStack - Configurazione Ambiente di Produzione & Sviluppo
# ==============================================================================

# --- Dominio & Applicazione ---
NODE_ENV=production
APP_URL=https://tuodominio.it
APP_DOMAIN=tuodominio.it
PORT=3000

# --- Database PostgreSQL ---
POSTGRES_USER=zerostack
POSTGRES_PASSWORD=genera_una_password_sicura_qui_2026
POSTGRES_DB=zerostack
DATABASE_URL=postgresql://zerostack:genera_una_password_sicura_qui_2026@postgres:5432/zerostack?schema=public

# --- Redis Cache & Queue ---
REDIS_URL=redis://redis:6379

# --- Autenticazione & Sicurezza ---
NEXTAUTH_SECRET=genera_un_hash_segreto_con_openssl_rand_hex_32
NEXTAUTH_URL=https://tuodominio.it

# --- Monetizzazione Stripe (0% trattenute ZeroStack, 100% al creator) ---
STRIPE_SECRET_KEY=sk_live_tuachiavestripe
STRIPE_PUBLISHABLE_KEY=pk_live_tuachiavestripe
STRIPE_WEBHOOK_SECRET=whsec_tuosegretowebhook
# Segreto dell'endpoint webhook in ascolto dei conti collegati (Connect), se diverso dal precedente
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Provider Email Newsletter (Server UE e Deliverability Massima) ---
# Quale provider usare: brevo | resend | turbosmtp | smtp | log (log = nessun invio, solo registro).
# Va scelto esplicitamente: le chiavi qui sotto da sole non attivano niente.
EMAIL_PROVIDER=brevo
# Mittente di piattaforma (dominio verificato presso il provider con SPF/DKIM/DMARC).
# Il nome visualizzato è quello della pubblicazione; le risposte vanno al fromEmail della redazione.
EMAIL_FROM=newsletter@tuodominio.it
# Email al secondo inviate dal worker (rispetta il limite del tuo piano)
EMAIL_RATE_PER_SECOND=10
# Webhook di rimbalzi e segnalazioni di spam (vedi README)
# Brevo: URL https://tuodominio.it/api/email/webhook/brevo?token=<EMAIL_WEBHOOK_TOKEN>
# turboSMTP: URL https://tuodominio.it/api/email/webhook/turbosmtp?token=<EMAIL_WEBHOOK_TOKEN>
EMAIL_WEBHOOK_TOKEN=genera_con_openssl_rand_hex_24
# Resend: segreto di firma dell'endpoint https://tuodominio.it/api/email/webhook/resend
RESEND_WEBHOOK_SECRET=

# Opzione 1: Brevo (ex Sendinblue - Consigliato per UE e conformità GDPR)
BREVO_API_KEY=xkeysib-tuachiavebrevo

# Opzione 2: Resend
RESEND_API_KEY=re_tuachiaveresend

# Opzione 3: turboSMTP (provider italiano, API HTTP; di default l'infrastruttura europea)
TURBOSMTP_CONSUMER_KEY=
TURBOSMTP_CONSUMER_SECRET=
# Facoltativo: https://api.turbo-smtp.com/api/v2 per l'infrastruttura globale
TURBOSMTP_API_BASE=https://api.eu.turbo-smtp.com/api/v2

# Opzione 4: SMTP Personalizzato generico (vale anche per il server SMTP di turboSMTP)
SMTP_HOST=smtp.tuodominio.it
SMTP_PORT=587
SMTP_USER=newsletter@tuodominio.it
SMTP_PASS=tuapasswordsmtp
SMTP_FROM="Tech & Futuro Italia <newsletter@tuodominio.it>"

# --- File caricati (immagini, audio dei podcast) ---
# local = disco del server (volume /data/uploads, da includere nei backup) | s3 = storage compatibile S3
STORAGE_DRIVER=local
# Con s3 servono anche S3_PUBLIC_URL (indirizzo pubblico del bucket, es. https://media.tuodominio.it)
# e, per R2/MinIO, S3_ENDPOINT. S3_FORCE_PATH_STYLE=true per MinIO.
S3_PUBLIC_URL=

# --- Dati del gestore per privacy, termini e cookie ---
LEGAL_ENTITY_NAME="Ragione sociale o nome e cognome"
LEGAL_VAT_NUMBER=
LEGAL_ADDRESS="Via, CAP, Città"
LEGAL_CONTACT_EMAIL=privacy@tuodominio.it

# --- Storage Media (S3 / Cloudflare R2 / MinIO) ---
S3_BUCKET=zerostack-media
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=https://tuo-account.r2.cloudflarestorage.com

# --- Backup (servizio zerostack-backup) ---
# Passphrase per cifrare i backup: conservala FUORI dal server, senza non si ripristina nulla.
BACKUP_PASSPHRASE=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
# Storage S3 esterno per la copia fuori dal server (bucket privato, diverso da quello dei media)
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=zerostack/
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# --- Monitoraggio ---
# DSN di Sentry o GlitchTip (https://<chiave>@<host>/<progetto>): senza, gli errori restano nei log
ERROR_REPORTING_DSN=
# Indirizzo che riceve gli avvisi (backup non riuscito)
ALERT_EMAIL=
# /api/health segnala un problema se l'ultimo backup riuscito è più vecchio di così
HEALTH_REQUIRE_BACKUP=true
BACKUP_MAX_AGE_HOURS=26
