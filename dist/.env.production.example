# ==============================================================================
# ZeroStack - Parametri di Produzione per VPS
# ==============================================================================

NODE_ENV=production
APP_URL=https://zerostack.it
APP_DOMAIN=zerostack.it
NEXT_PUBLIC_ROOT_DOMAIN=zerostack.it

# --- Database PostgreSQL ---
POSTGRES_USER=zerostack
POSTGRES_PASSWORD=imposta_password_robusta_qui
POSTGRES_DB=zerostack

# --- Autenticazione & Sicurezza ---
NEXTAUTH_SECRET=genera_con_openssl_rand_hex_32
NEXTAUTH_URL=https://tuodominio.it

# --- Stripe Connect (0% fee trattenute, 100% al creator) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email Provider Newsletter (Brevo server UE o Resend) ---
BREVO_API_KEY=xkeysib-...
RESEND_API_KEY=re_...
