{
    # SSL On-demand per domini personalizzati illimitati dei creator (gratuito)
    on_demand_tls {
        ask http://web:3000/api/domains/check
    }
}

# Dominio principale di produzione
{$APP_DOMAIN:zerostack.it} {
    encode gzip zstd
    reverse_proxy web:3000
}

# Gestione dinamica per tutti i sottodomini e domini personalizzati puntati via CNAME
:443 {
    tls {
        on_demand
    }
    encode gzip zstd
    reverse_proxy web:3000
}
